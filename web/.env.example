# API do Django (T-011). O cliente pede a sessão em POST {VITE_API_URL}/api/sessions e abre o
# WebSocket no `ws_url` que vier no ticket — não monta a URL do WS por conta própria.
# VITE_API_URL=http://localhost:8000

# Escape para trabalhar sem servidor: com esta variável o cliente pula a admissão e fala
# direto com o mock (`npm run mock:gateway`, ws://localhost:8787). Deixe vazia para o
# caminho real.
# VITE_WS_URL=ws://localhost:8787

# Token para o mock / teste manual (no caminho real o token vem no ticket).
# VITE_WS_TOKEN=

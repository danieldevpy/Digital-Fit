# Copie para .env apenas se precisar sobrescrever os defaults.
# O docker-compose sobe sem nenhum .env.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-key-nao-usar-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,[::1]

# Postgres
POSTGRES_DB=digitalfit
POSTGRES_USER=digitalfit
POSTGRES_PASSWORD=digitalfit
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Token de sessao (SPEC-009): assinatura HMAC do token do WebSocket
SESSION_TOKEN_SECRET=dev-token-secret

# Portas expostas no host
API_PORT=8000
GATEWAY_PORT=8001

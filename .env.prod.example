# Digital Fit — producao. Copie para `.env.prod` e preencha:
#
#   cp .env.prod.example .env.prod
#   ./scripts/prod.sh secrets   # gera DJANGO_SECRET_KEY e SESSION_TOKEN_SECRET
#   ./scripts/prod.sh up
#
# `.env.prod` NAO vai para o git (ver .gitignore).

# ---------------------------------------------------------------------------
# A unica coisa que voce realmente precisa decidir
# ---------------------------------------------------------------------------
# Dominio publico, SEM esquema e SEM barra. O script deriva daqui:
#   VITE_API_URL         = https://<DOMAIN>
#   GATEWAY_WS_URL       = wss://<DOMAIN>
#   DJANGO_ALLOWED_HOSTS = <DOMAIN>
#   CORS_ALLOWED_ORIGINS = https://<DOMAIN>
#
# Tem de ser HTTPS de verdade: `getUserMedia` so existe em contexto seguro, entao a camera
# do celular nao abre em http nem por IP da rede local. Foi por isso que este ambiente nasceu.
DOMAIN=treino.seudominio.com.br

# ---------------------------------------------------------------------------
# SITE | APP em subdominios (opcional — T-067)
# ---------------------------------------------------------------------------
# Vazios: site e app vivem no MESMO dominio, em `/` e `/app/`. Nada a configurar.
#
# Preenchidos: o script grava as origens completas no bundle (os links de um lado apontam
# para o host do outro) e coloca os dois hosts no ALLOWED_HOSTS e no CORS. O `Host` da API
# nao e detalhe: um app em host novo bateria numa API que o recusa, e o sintoma no celular
# seria so "sem conexao".
#
# Depois de preencher, rode `./scripts/prod.sh nginx` — o bloco muda: o app passa a ser
# servido na RAIZ do proprio host, mapeada para /app/index.html.
#
# SITE_DOMAIN=site.seudominio.com.br
# APP_DOMAIN=app.seudominio.com.br

# ---------------------------------------------------------------------------
# Segredos — gere com `./scripts/prod.sh secrets`
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=
# Assina o token do WebSocket (SPEC-009). Trocar este valor invalida as sessoes em voo.
SESSION_TOKEN_SECRET=
# Assina os JWT das contas (SPEC-011). Trocar este valor desloga todo mundo — inclusive os
# refresh, que valem 14 dias. E separado do DJANGO_SECRET_KEY justamente para que girar um
# nao arraste o outro.
JWT_SIGNING_KEY=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Opcionais — os defaults servem
# ---------------------------------------------------------------------------
POSTGRES_DB=digitalfit
POSTGRES_USER=digitalfit

# Onde as portas escutam no host. 127.0.0.1 e o certo quando o nginx esta na MESMA maquina:
# nada fica exposto a internet sem passar por ele. Use 0.0.0.0 apenas se o proxy for externo
# — e nesse caso proteja com firewall: abrir sessao continua sendo anonimo (trial por
# aparelho, SPEC-011), entao a porta exposta e treino de graca para quem achar o IP.
# Estas portas existem SO entre o seu nginx e o Docker — nunca aparecem para o usuario.
# Se a VPS ja usa alguma delas (outro app, outro projeto), troque a vontade: o
# `./scripts/prod.sh nginx` imprime o proxy_pass ja com os valores daqui. O `up` recusa
# subir quando a porta esta ocupada, antes de buildar qualquer coisa.
BIND_ADDR=127.0.0.1
WEB_PORT=8080
API_PORT=8000
GATEWAY_PORT=8001

# Processos do gunicorn (api). Regra de bolso: 2 x vCPU + 1.
API_WORKERS=3

LOG_LEVEL=INFO
REDIS_MAXMEMORY=256mb

# Painel de operacao (SPEC-018). Vem DESLIGADO: ele e a primeira superficie deste projeto com
# login por cookie, e le conta e sessao de todo mundo. Ligue quando for usar, e nao "por via
# das duvidas". A primeira conta sai de `./scripts/prod.sh exec api python manage.py
# createsuperuser` — nao ha painel onde cria-la.
DJANGO_ENABLE_ADMIN=0
# Troque por algo so seu: `/admin` e a primeira URL que um scanner tenta, `painel/` e a
# segunda. A barra final e opcional — o script normaliza. Depois de mudar aqui, rode
# `./scripts/prod.sh nginx` de novo: o `location` do painel sai com o caminho novo, e sem ele
# a URL cai no container do web e abre a LANDING com status 200 (nao um 404).
DJANGO_ADMIN_PATH=painel/
# Origem do painel COM esquema (`https://treino.seudominio.com`). Sem ela o POST do login
# falha no CSRF atras do nginx que termina TLS.
#
# DERIVADA do DOMAIN quando vazia (a quinta derivada, junto com as quatro do topo deste
# arquivo). So preencha se o painel responder num host DIFERENTE do DOMAIN.
CSRF_TRUSTED_ORIGINS=
